],[[1,3448]],["DIV",{},[[1,3450]],["INPUT",{"__playwright_value_":"Nachhaltig. Sicher. Trocken.","id":"docTagline"}]],[[1,3453]],["DIV",{"class":"full"},[[1,3455]],["INPUT",{"__playwright_value_":"Bauwerksabdichtung im Bestand","id":"docDocumentSubtitle"}]],[[1,3458]]],[[1,3460]],[[1,3465]],[[1,3466]],[[1,3467]],[[1,3468]]],[[1,3470]],["DETAILS",{"class":"card","open":""},[[1,3471]],[[1,3473]],[[1,3474]],[[1,3476]],[[1,3477]],[[1,3479]],[[1,3480]],["TEXTAREA",{"__playwright_value_":"{{ANREDE}},\n\nauf Grundlage unserer Ortsbesichtigung und der durchgeführten Schadenanalyse am Objekt {{OBJEKTANSCHRIFT}} erhalten Sie nachfolgend unser Angebot über die mit Ihnen abgestimmten Abdichtungsmaßnahmen.\n\nDas Angebot basiert auf den zum Zeitpunkt der Besichtigung erkennbaren Schadensmerkmalen, den vor Ort festgestellten Gegebenheiten sowie den gemeinsam abgestimmten technischen Anforderungen. Es umfasst ausschließlich die besprochenen und im Aufmaß gekennzeichneten Wand- beziehungsweise Bauteilbereiche. Nach Abschluss der Arbeiten kann die Situation gemeinsam bewertet und bei Bedarf über weitere Maßnahmen entschieden werden.\n\nFür die Ausführung verwenden wir aufeinander abgestimmte Abdichtungssysteme aus dem Hause BKM.MANNESMANN, die speziell für die Sanierung von feuchtem Mauerwerk entwickelt wurden.\n\nIhre Vorteile:\n– Aufeinander abgestimmtes Produktsystem für eine technisch sichere und nachhaltige Ausführung\n– Jahrzehntelange europaweite Erfahrung in der Bauwerksabdichtung und Mauertrocknung\n– Attraktives Preis-Leistungs-Verhältnis\n– Schnelle, saubere und zuverlässige Ausführung\n– Praxiserprobte Produkte für die Bauwerksabdichtung\n{{HZ_VOC_VORTEIL}}\n\nDie Auswahl des Abdichtungssystems erfolgt passend zur festgestellten Schadenssituation und zu den technischen Anforderungen des jeweiligen Bauteils.","id":"offerIntroductionText","rows":"22"}],[[1,3482]],["P",{"id":"offerIntroductionCount","class":"hint"},"Einleitung: 1329 von maximal 2.000 Zeichen"],[[1,3484]],[[1,3486]],[[1,3487]]],[[1,3489]],["DETAILS",{"class":"card","open":""},[[1,3490]],[[1,3492]],[[1,3493]],[[1,3495]],[[1,3496]],["DIV",{"class":"grid"},[[1,3497]],["DIV",{},[[1,3499]],["INPUT",{"__playwright_value_":"2026-07-26","id":"lexofficeOfferImportFrom","type":"date"}]],[[1,3502]]],[[1,3504]]],[[1,3506]],["DETAILS",{"class":"card","open":""},[[1,3507]],[[1,3509]],[[1,3510]],[[1,3512]],[[1,3513]],["DIV",{"class":"grid"},[[1,3514]],["DIV",{},[[1,3516]],["INPUT",{"__playwright_value_":"Mike Sprager","id":"employeeName1","autocomplete":"name"}]],[[1,3519]],[[1,3523]],[[1,3524]],[[1,3528]],[[1,3529]]],[[1,3531]]],[[1,3533]],["DETAILS",{"class":"card","open":""},[[1,3534]],[[1,3536]],[[1,3537]],[[1,3539]],[[1,3540]],["DIV",{"id":"visitRequirementSettings","class":"mapping-grid"},["H3",{"class":"requirement-group-title"},"Kunde und Termin"],"\n      ",["LABEL",{"class":"check-row"},"\n        ",["INPUT",{"__playwright_value_":"on","__playwright_checked_":"true","type":"checkbox","data-visit-requirement":"visitEmployee","checked":""}],"\n        ",["SPAN",{},["STRONG",{},"Mitarbeiter"],["SMALL",{},"Pflicht – wird bei Abschluss geprüft"]],"\n      "],"\n      ",["LABEL",{"class":"check-row"},"\n        ",["INPUT",{"__playwright_value_":"on","__playwright_checked_":"true","type":"checkbox","data-visit-requirement":"visitStartTime","checked":""}],"\n        ",["SPAN",{},["STRONG",{},"Besichtigung begonnen"],["SMALL",{},"Pflicht – wird bei Abschluss geprüft"]],"\n      "],["H3",{"class":"requirement-group-title"},"Abschluss"],"\n      ",["LABEL",{"class":"check-row"},"\n        ",["INPUT",{"__playwright_value_":"on","__playwright_checked_":"true","type":"checkbox","data-visit-requirement":"visitEndTime","checked":""}],"\n        ",["SPAN",{},["STRONG",{},"Besichtigung beendet"],["SMALL",{},"Pflicht – wird bei Abschluss geprüft"]],"\n      "],["H3",{"class":"requirement-group-title"},"Kunde und Termin"],"\n      ",["LABEL",{"class":"check-row"},"\n        ",["INPUT",{"__play