{"class":"catalog-row"},["DIV",{"class":"grid"},["DIV",{"class":"full"},["LABEL",{},"Lexoffice-Artikel"],["SELECT",{"data-extra-article":"47873457-b11f-4a25-9a81-5e1d49785970"},["OPTION",{"__playwright_selected_":"true","value":""},"nicht zugeordnet"]]],["DIV",{},["LABEL",{},"Bezeichnung"],["INPUT",{"__playwright_value_":"Sauberkeitspaket","data-extra":"47873457-b11f-4a25-9a81-5e1d49785970","data-extra-field":"name","value":"Sauberkeitspaket"}]],["DIV",{},["LABEL",{},"Einheit"],["INPUT",{"__playwright_value_":"pauschal","data-extra":"47873457-b11f-4a25-9a81-5e1d49785970","data-extra-field":"unit","value":"pauschal"}]],["DIV",{},["LABEL",{},"Preis brutto aus App"],["INPUT",{"__playwright_value_":"0","data-extra":"47873457-b11f-4a25-9a81-5e1d49785970","data-extra-field":"grossPrice","value":"0","inputmode":"decimal","autocomplete":"off","data-decimal-ready":"true"}]],["LABEL",{},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"true","type":"checkbox","data-extra-active":"47873457-b11f-4a25-9a81-5e1d49785970","checked":""}]," aktiv"],["BUTTON",{"class":"danger","data-extra-delete":"47873457-b11f-4a25-9a81-5e1d49785970"},"Löschen"]]],["DIV",{"class":"catalog-row"},["DIV",{"class":"grid"},["DIV",{"class":"full"},["LABEL",{},"Lexoffice-Artikel"],["SELECT",{"data-extra-article":"b2fbc4f5-b168-4ecd-8592-8eaa9ae79417"},["OPTION",{"__playwright_selected_":"true","value":""},"nicht zugeordnet"]]],["DIV",{},["LABEL",{},"Bezeichnung"],["INPUT",{"__playwright_value_":"Bauschutt entsorgen","data-extra":"b2fbc4f5-b168-4ecd-8592-8eaa9ae79417","data-extra-field":"name","value":"Bauschutt entsorgen"}]],["DIV",{},["LABEL",{},"Einheit"],["INPUT",{"__playwright_value_":"pauschal","data-extra":"b2fbc4f5-b168-4ecd-8592-8eaa9ae79417","data-extra-field":"unit","value":"pauschal"}]],["DIV",{},["LABEL",{},"Preis brutto aus App"],["INPUT",{"__playwright_value_":"0","data-extra":"b2fbc4f5-b168-4ecd-8592-8eaa9ae79417","data-extra-field":"grossPrice","value":"0","inputmode":"decimal","autocomplete":"off","data-decimal-ready":"true"}]],["LABEL",{},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"true","type":"checkbox","data-extra-active":"b2fbc4f5-b168-4ecd-8592-8eaa9ae79417","checked":""}]," aktiv"],["BUTTON",{"class":"danger","data-extra-delete":"b2fbc4f5-b168-4ecd-8592-8eaa9ae79417"},"Löschen"]]]],[[1,3739]],[[1,3740]]],[[1,3742]],["DETAILS",{"class":"card"},[[1,3744]],[[1,3745]],[[1,3747]],[[1,3748]],[[1,3750]],[[1,3751]],["TEXTAREA",{"__playwright_value_":"Feuchteschäden können unterschiedliche Ursachen und Folgeschäden aufweisen. Die Bearbeitung erfolgt daher im Ausschlussverfahren. Es werden zunächst die sichtbaren und messbaren Schadensursachen bearbeitet. Nach einer angemessenen Standzeit wird das Bauwerk erneut überprüft. Weitere Maßnahmen erfolgen nur nach gesonderter Feststellung und Abstimmung mit dem Auftraggeber. Werden infolge des Schadensbildes nach der Injektion zusätzliche Fehlstellen, zum Beispiel Risse oder Kiesnester, sichtbar, sind ergänzende Maßnahmen, zum Beispiel eine Harzverpressung, gesondert zu beauftragen und abzurechnen.\n\nDie angebotene Abdichtungsmaßnahme dient ausschließlich der Unterbindung des kapillaren Feuchtetransports im Bauteil. Nicht Bestandteil des Angebots sind Schäden oder Feuchteeintritte infolge von drückendem Wasser, Rissen im Mauerwerk oder Putz, Undichtigkeiten im Boden-Wand-Anschluss, mangelhaften Wanddurchführungen oder vergleichbaren Fremdeinflüssen.\n\nMaßnahmen gegen drückendes Wasser beziehungsweise eindringendes Wasser sind nicht enthalten und werden, soweit erforderlich, gesondert berechnet (98,00 € brutto je Packer). Maßnahmen gegen eine Über- oder Unterwanderung der Abdichtung sind ebenfalls nicht enthalten. Hierfür können ergänzende Abdichtungsmaßnahmen, zum Beispiel eine Erweiterung der Horizontalsperre oder Flächensperre, erforderlich werden.\n\nNach ausreichender Austrocknung kann ein Austausch des salzbelasteten Putzsystems erforderlich sein. Diese Leistung ist nicht Bestandteil des Angebots.\n\nGewährleistungsansprüche bestehen nicht für Schäden infolge außergewöhnlicher Naturereignisse, insbesondere Hochwasser, Starkregen oder Überflutung, soweit diese außerhalb des vereinbarten Leistungsumfangs liegen.\n\nGrundlage der Ausführung ist die jeweils gültige Richtlinie „Flächensperre / Horizontalsperre mit flüssigen Injektionsmitteln“ der BKM.MANNESMANN AG. Im Übrigen gelten die gesetzlichen Vorschriften des BGB.","id":"noticeStandard","class":"large-setting-text"}],[[1,3753]],["P",{"id":"noticeStandardCount","class":"hint"},"Allgemeiner Hinweis: 1942 von maximal 2.000 Zeichen"],[[1,3755]],[[1,3757]],[[1,3758]],["TEXTAREA",{"__playwright_value_":"Der Wand-Sohlen-Anschluss wird grundsätzlich im Ausschlussverfahren ausgeführt. Der Leistungsumfang umfasst das Öffnen des Estrichs auf einer Breite von mindestens ca. 15–20 cm von der Wand bis zur Bodenplatte, die Reinigung des Anschlussbereiches, die Herstellung einer Dichtkehle, das Aufbringen des Dichtmörtels bis mindestens 15 cm über eine vorhandene Sperrbahn sowie das anschließende Einbringen einer Horizontalsperre mit BKM HZ 250 Pro.\n\nNach einer angemessenen Standzeit wird das Bauwerk erneut überprüft. Sollte sich dabei zeigen, dass eine ergänzende Harzverpressung erforderlich ist, wird diese ausschließlich in den tatsächlich notwendigen Bereichen ausgeführt und nach dem tatsächlich ausgeführten Umfang gesondert berechnet.","id":"noticeWallSole","class":"large-setting-text"}],[[1,3760]],["P",{"id":"noticeWallSoleCount","class":"hint"},"Zusatz Wand-Sohlen-Anschluss: 739 von maximal 2.000 Zeichen"],[[1,3762]],[[1,3764]],[[1,3765]],["TEXTAREA",{"__playwright_value_":"Harzverpressungen erfassen ausschließlich die zum Zeitpunkt der Ausführung festgestellten und zugänglichen Fehlstellen. Weitere Fehlstellen können erst im Zuge der Austrocknung oder nach einer angemessenen Standzeit sichtbar werden. Hieraus entstehende ergänzende Maßnahmen sind gesondert festzustellen, mit dem Auftraggeber abzustimmen, zu beauftragen und abzurechnen.","id":"noticeResin","class":"large-setting-text"}],[[1,3767]],["P",{"id":"noticeResinCount","class":"hint"},"Zusatz Harzverpressung: 369 von maximal 2.000 Zeichen"],[[1,3769]],["DIV",{"id":"lexofficeTextLimitStatus","class":"status error"},"Achtung: Mit allen Zusatzhinweisen 3112 von 2.000 Zeichen. Das betreffende Angebot kann erst nach dem Kürzen übertragen werden."],[[1,3771]]],[[1,3773]],["DETAILS",{"class":"card","open":""},[[1,3775]],[[1,3776]],[[1,3778]],[[1,3779]],["DIV",{"class":"connection-actions"},[[1,3780]],[[1,3782]],[[1,3783]],["LABEL",{"class":"check-row compact-check"},["INPUT",{"__playwright_value_":"on","__playwright_checked_":"true","id":"pipedriveAutoSync","type":"checkbox"}],[[1,3785]]],[[1,3787]]],[[1,3789]],[[1,3790]],[[1,3791]],[[1,3793]],[[1,3794]],[[1,3796]],[[1,3797]],["DIV",{"id":"pipedrivePersonFieldMappings","class":"mapping-grid"},"\n      ",["DIV",{"class":"mapping-item"},["LABEL",{},"Postanschrift"],["SELECT",{"data-person-field-mapping":"postalAddress"},["OPTION",{"__playwright_selected_":"true","value":""},"nicht zugeordnet"]]],"\n      ",["DIV",{"class":"mapping-item"},["LABEL",{},"Objektanschrift"],["SELECT",{"data-person-field-mapping":"objectAddress"},["OPTION",{"__playwright_selected_":"true","value":""},"nicht zugeordnet"]]]],[[1,3799]],[[1,3801]],["DIV",{"id":"pipedriveStageMappings","class":"mapping-grid"},"\n    ",["DIV",{"class":"mapping-item"},["LABEL",{},"Anfragen"],["SELECT",{"data-stage-mapping":"inquiry"},["OPTION",{"__playwright_selected_":"true","value":""},"nicht zugeordnet"]]],"\n    ",["DIV",{"class":"mapping-item"},["LABEL",{},"Kontakt hergestellt"],["SELECT",{"data-stage-mapping":"contactMade"},["OPTION",{"__playwright_selected_":"true","value":""},"nicht zugeordnet"]]],"\n    ",["DIV",{"class":"mapping-item"},["LABEL",{},"Warten auf Kundenrückmeldung"],["SELECT",{"data-stage-mapping":"waitingCustomer"},["OPTION",{"__playwright_selected_":"true","value":""},"nic